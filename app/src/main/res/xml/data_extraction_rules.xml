<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="spark_gym.db" />
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="sparkgym_secure_tokens.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="spark_gym.db" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
